<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_request_issue" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_request_issue">
    <bpmn:participant id="P_emp" name="Сотрудник" processRef="Process_P_emp" />
    <bpmn:participant id="P_org" name="Учёт и выдача оборудования" processRef="Process_P_org" />
    <bpmn:messageFlow id="Msg_e_submit_s_start" name="Заявка" sourceRef="e_submit" targetRef="s_start" />
    <bpmn:messageFlow id="Msg_P_emp_b_cancel" name="Отмена до решения" sourceRef="P_emp" targetRef="b_cancel" />
    <bpmn:messageFlow id="Msg_s_confirmed_e_status" name="Статус «подтверждено»" sourceRef="s_confirmed" targetRef="e_status" />
    <bpmn:messageFlow id="Msg_s_rejected_end_e_status" name="Статус «отклонено»" sourceRef="s_rejected_end" targetRef="e_status" />
    <bpmn:messageFlow id="Msg_e_cancel_s_cancel_msg" name="Отмена заявки" sourceRef="e_cancel" targetRef="s_cancel_msg" />
    <bpmn:messageFlow id="Msg_e_go_w_came" name="Обращение на склад" sourceRef="e_go" targetRef="w_came" />
    <bpmn:messageFlow id="Msg_w_hand_e_got" name="Единица" sourceRef="w_hand" targetRef="e_got" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P_emp" isExecutable="false">
    <bpmn:startEvent id="e_start" name="Нужно оборудование">
      <bpmn:outgoing>Flow_e_start_e_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="e_submit" name="Подать заявку на единицу «в наличии»">
      <bpmn:incoming>Flow_e_start_e_submit</bpmn:incoming>
      <bpmn:outgoing>Flow_e_submit_e_status</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="e_status" name="Решение по заявке получено">
      <bpmn:incoming>Flow_e_submit_e_status</bpmn:incoming>
      <bpmn:outgoing>Flow_e_status_e_ok</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e_status_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="e_ok" name="Заявка подтверждена?">
      <bpmn:incoming>Flow_e_status_e_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_e_ok_e_rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_e_ok_e_need</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_rejected" name="Оборудование не получено">
      <bpmn:incoming>Flow_e_ok_e_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="e_need" name="Оборудование ещё нужно?">
      <bpmn:incoming>Flow_e_ok_e_need</bpmn:incoming>
      <bpmn:outgoing>Flow_e_need_e_cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_e_need_e_go</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="e_cancel" name="Отменить заявку">
      <bpmn:incoming>Flow_e_need_e_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_e_cancel_e_cancelled</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e_cancelled" name="Заявка отменена">
      <bpmn:incoming>Flow_e_cancel_e_cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="e_go" name="Прийти на склад в дату начала">
      <bpmn:incoming>Flow_e_need_e_go</bpmn:incoming>
      <bpmn:outgoing>Flow_e_go_e_got</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="e_got" name="Единица получена">
      <bpmn:incoming>Flow_e_go_e_got</bpmn:incoming>
      <bpmn:outgoing>Flow_e_got_e_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e_got_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_end" name="Оборудование получено">
      <bpmn:incoming>Flow_e_got_e_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_e_start_e_submit" sourceRef="e_start" targetRef="e_submit" />
    <bpmn:sequenceFlow id="Flow_e_submit_e_status" sourceRef="e_submit" targetRef="e_status" />
    <bpmn:sequenceFlow id="Flow_e_status_e_ok" sourceRef="e_status" targetRef="e_ok" />
    <bpmn:sequenceFlow id="Flow_e_ok_e_rejected" name="нет" sourceRef="e_ok" targetRef="e_rejected" />
    <bpmn:sequenceFlow id="Flow_e_ok_e_need" name="да" sourceRef="e_ok" targetRef="e_need" />
    <bpmn:sequenceFlow id="Flow_e_need_e_cancel" name="нет" sourceRef="e_need" targetRef="e_cancel" />
    <bpmn:sequenceFlow id="Flow_e_cancel_e_cancelled" sourceRef="e_cancel" targetRef="e_cancelled" />
    <bpmn:sequenceFlow id="Flow_e_need_e_go" name="да" sourceRef="e_need" targetRef="e_go" />
    <bpmn:sequenceFlow id="Flow_e_go_e_got" sourceRef="e_go" targetRef="e_got" />
    <bpmn:sequenceFlow id="Flow_e_got_e_end" sourceRef="e_got" targetRef="e_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_org" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_org">
      <bpmn:lane id="L_sys" name="АС УВО">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cancel_p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cancel_p_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_expire_p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_expire_p_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_booked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rejected_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cancel_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cancel_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_expire_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_check_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_limit_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_issue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_resp" name="Ответственное лицо">
        <bpmn:flowNodeRef>r_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_expire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_wh" name="Заведующий складом">
        <bpmn:flowNodeRef>w_came</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Заявка получена">
      <bpmn:outgoing>Flow_s_start_s_queue</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_start_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="s_queue" name="Поставить заявку в очередь">
      <bpmn:incoming>Flow_s_start_s_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_s_queue_r_review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="r_review" name="Рассмотреть заявку">
      <bpmn:incoming>Flow_s_queue_r_review</bpmn:incoming>
      <bpmn:outgoing>Flow_r_review_r_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="r_decision" name="Решение?">
      <bpmn:incoming>Flow_r_review_r_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_r_decision_r_confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_r_decision_r_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="r_confirm" name="Подтвердить заявку">
      <bpmn:incoming>Flow_r_decision_r_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_r_confirm_s_book</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="r_reject" name="Отклонить заявку">
      <bpmn:incoming>Flow_r_decision_r_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_r_reject_s_rejected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_cancel" name="Сотрудник отменил заявку" attachedToRef="r_review" cancelActivity="true">
      <bpmn:outgoing>Flow_b_cancel_s_cancel_p</bpmn:outgoing>
      <bpmn:messageEventDefinition id="b_cancel_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_expire" name="Конец даты начала использования" attachedToRef="r_review" cancelActivity="true">
      <bpmn:outgoing>Flow_b_expire_s_expire_p</bpmn:outgoing>
      <bpmn:timerEventDefinition id="b_expire_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="s_cancel_p" name="Установить «отменена»">
      <bpmn:incoming>Flow_b_cancel_s_cancel_p</bpmn:incoming>
      <bpmn:outgoing>Flow_s_cancel_p_s_cancel_p_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_cancel_p_end" name="Заявка отменена">
      <bpmn:incoming>Flow_s_cancel_p_s_cancel_p_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_expire_p" name="Установить «истекла»">
      <bpmn:incoming>Flow_b_expire_s_expire_p</bpmn:incoming>
      <bpmn:outgoing>Flow_s_expire_p_s_expire_p_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_expire_p_end" name="Заявка истекла">
      <bpmn:incoming>Flow_s_expire_p_s_expire_p_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_book" name="Забронировать единицу">
      <bpmn:incoming>Flow_r_confirm_s_book</bpmn:incoming>
      <bpmn:outgoing>Flow_s_book_s_booked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_booked" name="Единица была «в наличии»?">
      <bpmn:incoming>Flow_s_book_s_booked</bpmn:incoming>
      <bpmn:outgoing>Flow_s_booked_s_confirmed</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_booked_s_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_confirmed" name="Установить «подтверждено»">
      <bpmn:incoming>Flow_s_booked_s_confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_s_confirmed_s_wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_rejected" name="Установить «отклонено»">
      <bpmn:incoming>Flow_s_booked_s_rejected</bpmn:incoming>
      <bpmn:incoming>Flow_r_reject_s_rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_s_rejected_s_rejected_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_rejected_end" name="Заявка отклонена">
      <bpmn:incoming>Flow_s_rejected_s_rejected_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="s_rejected_end_def" />
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="s_wait" name="">
      <bpmn:incoming>Flow_s_confirmed_s_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_s_wait_s_cancel_msg</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_wait_s_timer</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_wait_w_came</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="s_cancel_msg" name="Сотрудник отменил заявку">
      <bpmn:incoming>Flow_s_wait_s_cancel_msg</bpmn:incoming>
      <bpmn:outgoing>Flow_s_cancel_msg_s_cancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_cancel_msg_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="s_cancel" name="Установить «отменена», снять бронь">
      <bpmn:incoming>Flow_s_cancel_msg_s_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_s_cancel_s_cancel_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_cancel_end" name="Заявка отменена">
      <bpmn:incoming>Flow_s_cancel_s_cancel_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="s_timer" name="Конец даты начала использования">
      <bpmn:incoming>Flow_s_wait_s_timer</bpmn:incoming>
      <bpmn:outgoing>Flow_s_timer_s_expire</bpmn:outgoing>
      <bpmn:timerEventDefinition id="s_timer_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="s_expire" name="Установить «истекла», снять бронь">
      <bpmn:incoming>Flow_s_timer_s_expire</bpmn:incoming>
      <bpmn:outgoing>Flow_s_expire_s_expire_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_expire_end" name="Заявка истекла">
      <bpmn:incoming>Flow_s_expire_s_expire_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="w_came" name="Сотрудник пришёл на склад">
      <bpmn:incoming>Flow_s_wait_w_came</bpmn:incoming>
      <bpmn:outgoing>Flow_w_came_w_scan</bpmn:outgoing>
      <bpmn:messageEventDefinition id="w_came_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="w_scan" name="Отсканировать штрихкод или ввести номер">
      <bpmn:incoming>Flow_w_came_w_scan</bpmn:incoming>
      <bpmn:incoming>Flow_s_check_ok_w_scan</bpmn:incoming>
      <bpmn:outgoing>Flow_w_scan_s_check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_check" name="Проверить заявку, единицу и лимит">
      <bpmn:incoming>Flow_w_scan_s_check</bpmn:incoming>
      <bpmn:outgoing>Flow_s_check_s_check_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_check_ok" name="Проверка пройдена?">
      <bpmn:incoming>Flow_s_check_s_check_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_s_check_ok_s_issue</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_check_ok_s_limit_end</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_check_ok_w_scan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="s_limit_end" name="Выдача не выполнена">
      <bpmn:incoming>Flow_s_check_ok_s_limit_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_issue" name="Записать выдачу">
      <bpmn:incoming>Flow_s_check_ok_s_issue</bpmn:incoming>
      <bpmn:outgoing>Flow_s_issue_w_hand</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="w_hand" name="Передать единицу сотруднику">
      <bpmn:incoming>Flow_s_issue_w_hand</bpmn:incoming>
      <bpmn:outgoing>Flow_w_hand_w_end</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="w_end" name="Оборудование выдано">
      <bpmn:incoming>Flow_w_hand_w_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_start_s_queue" sourceRef="s_start" targetRef="s_queue" />
    <bpmn:sequenceFlow id="Flow_r_review_r_decision" sourceRef="r_review" targetRef="r_decision" />
    <bpmn:sequenceFlow id="Flow_r_decision_r_confirm" name="подтвердить" sourceRef="r_decision" targetRef="r_confirm" />
    <bpmn:sequenceFlow id="Flow_r_decision_r_reject" name="отклонить" sourceRef="r_decision" targetRef="r_reject" />
    <bpmn:sequenceFlow id="Flow_r_confirm_s_book" sourceRef="r_confirm" targetRef="s_book" />
    <bpmn:sequenceFlow id="Flow_s_book_s_booked" sourceRef="s_book" targetRef="s_booked" />
    <bpmn:sequenceFlow id="Flow_s_booked_s_confirmed" name="да" sourceRef="s_booked" targetRef="s_confirmed" />
    <bpmn:sequenceFlow id="Flow_s_booked_s_rejected" name="нет" sourceRef="s_booked" targetRef="s_rejected" />
    <bpmn:sequenceFlow id="Flow_r_reject_s_rejected" sourceRef="r_reject" targetRef="s_rejected" />
    <bpmn:sequenceFlow id="Flow_s_rejected_s_rejected_end" sourceRef="s_rejected" targetRef="s_rejected_end" />
    <bpmn:sequenceFlow id="Flow_s_confirmed_s_wait" sourceRef="s_confirmed" targetRef="s_wait" />
    <bpmn:sequenceFlow id="Flow_s_wait_s_cancel_msg" sourceRef="s_wait" targetRef="s_cancel_msg" />
    <bpmn:sequenceFlow id="Flow_s_cancel_msg_s_cancel" sourceRef="s_cancel_msg" targetRef="s_cancel" />
    <bpmn:sequenceFlow id="Flow_s_cancel_s_cancel_end" sourceRef="s_cancel" targetRef="s_cancel_end" />
    <bpmn:sequenceFlow id="Flow_s_wait_s_timer" sourceRef="s_wait" targetRef="s_timer" />
    <bpmn:sequenceFlow id="Flow_s_timer_s_expire" sourceRef="s_timer" targetRef="s_expire" />
    <bpmn:sequenceFlow id="Flow_s_expire_s_expire_end" sourceRef="s_expire" targetRef="s_expire_end" />
    <bpmn:sequenceFlow id="Flow_s_wait_w_came" sourceRef="s_wait" targetRef="w_came" />
    <bpmn:sequenceFlow id="Flow_w_came_w_scan" sourceRef="w_came" targetRef="w_scan" />
    <bpmn:sequenceFlow id="Flow_w_scan_s_check" sourceRef="w_scan" targetRef="s_check" />
    <bpmn:sequenceFlow id="Flow_s_check_s_check_ok" sourceRef="s_check" targetRef="s_check_ok" />
    <bpmn:sequenceFlow id="Flow_s_check_ok_s_issue" name="да" sourceRef="s_check_ok" targetRef="s_issue" />
    <bpmn:sequenceFlow id="Flow_s_issue_w_hand" sourceRef="s_issue" targetRef="w_hand" />
    <bpmn:sequenceFlow id="Flow_w_hand_w_end" sourceRef="w_hand" targetRef="w_end" />
    <bpmn:sequenceFlow id="Flow_s_queue_r_review" sourceRef="s_queue" targetRef="r_review" />
    <bpmn:sequenceFlow id="Flow_b_cancel_s_cancel_p" sourceRef="b_cancel" targetRef="s_cancel_p" />
    <bpmn:sequenceFlow id="Flow_s_cancel_p_s_cancel_p_end" sourceRef="s_cancel_p" targetRef="s_cancel_p_end" />
    <bpmn:sequenceFlow id="Flow_b_expire_s_expire_p" sourceRef="b_expire" targetRef="s_expire_p" />
    <bpmn:sequenceFlow id="Flow_s_expire_p_s_expire_p_end" sourceRef="s_expire_p" targetRef="s_expire_p_end" />
    <bpmn:sequenceFlow id="Flow_s_check_ok_s_limit_end" name="лимит или заявка не действует" sourceRef="s_check_ok" targetRef="s_limit_end" />
    <bpmn:sequenceFlow id="Flow_s_check_ok_w_scan" name="единица не из заявки" sourceRef="s_check_ok" targetRef="w_scan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_request_issue">
    <bpmndi:BPMNPlane id="Plane_request_issue" bpmnElement="Collab_request_issue">
      <bpmndi:BPMNShape id="P_emp_di" bpmnElement="P_emp" isHorizontal="true"><dc:Bounds x="0" y="0" width="3600" height="230" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_start_di" bpmnElement="e_start"><dc:Bounds x="142" y="137" width="36" height="36" /></bpmndi:BPMNShape>
