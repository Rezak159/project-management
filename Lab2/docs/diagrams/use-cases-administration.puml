@startuml
title АС УВО – варианты использования: учёт оборудования, пользователи, отчёты
left to right direction
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam nodesep 30
skinparam ranksep 70

actor "Сотрудник" as EMP
actor "Пользователь с правом\n«управление пользователями»" as UM
actor "Администратор" as ADM

UM -up-|> EMP
ADM -up-|> UM

rectangle "АС УВО" {
  package "Учёт оборудования" {
    usecase "UC-11 Зарегистрировать единицу" as UC11
    usecase "UC-12 Напечатать этикетку" as UC12
    usecase "UC-13 Загрузить каталог из Excel" as UC13
    usecase "UC-14 Вести справочники и настройки" as UC14
  }
  package "Пользователи и роли" {
    usecase "UC-15 Создать учётную запись" as UC15
    usecase "UC-16 Загрузить сотрудников из Excel" as UC16
    usecase "UC-17 Назначить роли и лимит" as UC17
  }
  package "История и отчёты" {
    usecase "UC-22 Просмотреть историю единицы" as UC22
    usecase "UC-23 Сформировать отчёт" as UC23
    usecase "UC-24 Сформировать справку по сотруднику" as UC24
    usecase "UC-25 Просмотреть журнал действий" as UC25
  }
}

UM --> UC15
ADM --> UC11
ADM --> UC12
ADM --> UC13
ADM --> UC14
ADM --> UC16
ADM --> UC17
ADM --> UC22
ADM --> UC23
ADM --> UC24
ADM --> UC25
UC11 ..> UC12 : <<include>>
@enduml
