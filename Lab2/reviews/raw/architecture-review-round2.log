    10	  component "USB-сканер\n(режим клавиатуры)" as SC
    11	  component "Браузер\nстраницы, PWA" as BR
    12	  component "Принтер" as PR
    13	}
    14	
    15	package "Веб-приложение АС УВО" as WEB {
    16	  component "Доступ" as ACC
    17	  package "Прикладные модули" as APP {
    18	    component "Учёт\nоборудования" as EQ
    19	    component "Заявки" as REQ
    20	    component "Выдача\nи возврат" as ISS
    21	    component "Контроль\nсроков" as DL
    22	    component "История\nи отчёты" as REP
    23	  }
    24	  package "Общие модули" as COM {
    25	    component "Справочники\nи настройки" as SET
    26	    component "Уведомления" as NTF
    27	    component "Журнал" as LOG
    28	    component "Excel" as XLS
    29	    note "Используются всеми модулями:\nзапись в журнал, чтение справочников,\nзагрузка и выгрузка .xlsx" as NCOM
    30	  }
    31	}
    32	
    33	component "Планировщик\nзапуск каждые 15 минут" as SCH
    34	database "PostgreSQL" as DB
    35	component "Почтовый сервер\nзаказчика" as SMTP <<внешняя система>>
