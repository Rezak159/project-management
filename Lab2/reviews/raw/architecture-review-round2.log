     1	@startuml
     2	!pragma layout elk
     3	title АС УВО – диаграмма развёртывания
     4	skinparam shadowing false
     5	skinparam defaultFontName Arial
     6	skinparam componentStyle uml2
     7	
     8	node "Компьютер пользователя" as PC {
     9	  component "Браузер\nили установленное PWA" as BR
    10	  component "USB-сканер" as SC
    11	  component "Принтер\nэтикеток" as PR
    12	}
    13	
    14	node "Сервер заказчика\nLinux" as SRV {
    15	  component "nginx\nHTTPS, статические файлы" as NGX
    16	  component "gunicorn\nвеб-приложение АС УВО\n(Python, Django)" as APPS
    17	  database "PostgreSQL" as DB
    18	  component "systemd timer\nпланировщик, каждые 15 минут" as TMR
    19	}
    20	
    21	node "Хранилище резервных копий\nзаказчика" as BAK {
    22	  folder "Ежедневные копии базы\nи архив журнала транзакций" as ARC
    23	}
    24	
    25	node "Почтовый сервер\nзаказчика" as MAIL
    26	
    27	SC --> BR : USB, режим клавиатуры
    28	BR --> PR : печать из браузера
    29	BR --> NGX : HTTPS, порт 443
    30	NGX --> APPS : HTTP, localhost
    31	APPS --> DB : SQL, localhost
    32	TMR --> DB : SQL, localhost
    33	TMR --> MAIL : SMTP, STARTTLS
    34	APPS --> MAIL : SMTP, STARTTLS
    35	DB --> ARC : копия раз в сутки,\nжурнал транзакций не реже раза в 15 минут
    36	@enduml

