     1	@startuml
     2	title АС УВО – варианты использования: заявки, выдача, возврат, сроки
     3	left to right direction
     4	skinparam linetype polyline
     5	skinparam packageStyle rectangle
     6	skinparam shadowing false
     7	skinparam defaultFontName Arial
     8	skinparam actorStyle awesome
     9	skinparam nodesep 30
    10	skinparam ranksep 70
    11	
    12	actor "Сотрудник" as EMP
    13	actor "Ответственное\nлицо" as RESP
    14	actor "Заведующий\nскладом" as WH
    15	actor "Руководитель" as MGR
    16	actor "Время" as TIME
    17	
    18	rectangle "АС УВО" {
    19	  usecase "UC-01 Войти в систему" as UC01
    20	  package "Заявки" {
    21	    usecase "UC-02 Подать заявку" as UC02
    22	    usecase "UC-03 Отменить заявку" as UC03
    23	    usecase "UC-04 Просмотреть свои заявки" as UC04
    24	    usecase "UC-05 Взять заявку из очереди" as UC05
    25	    usecase "UC-06 Рассмотреть заявку" as UC06
    26	  }
    27	  package "Выдача и возврат" {
    28	    usecase "UC-07 Выдать оборудование" as UC07
    29	    usecase "UC-08 Принять возврат" as UC08
    30	    usecase "UC-09 Определить единицу\nпо штрихкоду или серийному номеру" as UC09
    31	    usecase "UC-10 Изменить статус единицы" as UC10
    32	  }
    33	  package "Контроль сроков" {
    34	    usecase "UC-18 Запросить продление" as UC18
    35	    usecase "UC-19 Согласовать продление" as UC19
    36	    usecase "UC-20 Просмотреть просроченные\nвыдачи сотрудников" as UC20
    37	    usecase "UC-21 Обработать сроки" as UC21
    38	  }
    39	}
    40	
    41	actor "Почтовый сервер\nзаказчика" as MAIL
    42	
    43	RESP -up-|> EMP
    44	WH -up-|> EMP
    45	MGR -up-|> EMP
    46	
    47	EMP --> UC01
    48	EMP --> UC02
    49	EMP --> UC03
    50	EMP --> UC04
    51	EMP --> UC18
    52	RESP --> UC05
    53	RESP --> UC06
    54	WH --> UC07
    55	WH --> UC08
    56	WH --> UC10
    57	MGR --> UC19
    58	MGR --> UC20
    59	
    60	UC07 ..> UC09 : <<include>>
    61	UC08 ..> UC09 : <<include>>
    62	
    63	TIME --> UC21
    64	UC01 --> MAIL
    65	UC21 --> MAIL
    66	@enduml
     1	@startuml
     2	title АС УВО – варианты использования: учёт оборудования, пользователи, отчёты
     3	left to right direction
     4	skinparam linetype polyline
     5	skinparam packageStyle rectangle
     6	skinparam shadowing false
     7	skinparam defaultFontName Arial
     8	skinparam actorStyle awesome
     9	skinparam nodesep 30
    10	skinparam ranksep 70
    11	
    12	actor "Сотрудник" as EMP
    13	actor "Пользователь с правом\n«управление пользователями»" as UM
    14	actor "Администратор" as ADM
    15	
    16	UM -up-|> EMP
    17	ADM -up-|> UM
    18	
    19	rectangle "АС УВО" {
    20	  package "Учёт оборудования" {
    21	    usecase "UC-11 Зарегистрировать единицу" as UC11
    22	    usecase "UC-12 Напечатать этикетку" as UC12
    23	    usecase "UC-13 Загрузить каталог из Excel" as UC13
    24	    usecase "UC-14 Вести справочники и настройки" as UC14
    25	  }
    26	  package "Пользователи и роли" {
    27	    usecase "UC-15 Создать учётную запись" as UC15
    28	    usecase "UC-16 Загрузить сотрудников из Excel" as UC16
    29	    usecase "UC-17 Назначить роли и лимит" as UC17
    30	  }
    31	  package "История и отчёты" {
    32	    usecase "UC-22 Просмотреть историю единицы" as UC22
    33	    usecase "UC-23 Сформировать отчёт" as UC23
    34	    usecase "UC-24 Сформировать справку по сотруднику" as UC24
    35	    usecase "UC-25 Просмотреть журнал действий" as UC25
    36	  }
    37	}
    38	
    39	UM --> UC15
    40	ADM --> UC11
    41	ADM --> UC12
    42	ADM --> UC13
    43	ADM --> UC14
    44	ADM --> UC16
    45	ADM --> UC17
    46	ADM --> UC22
    47	ADM --> UC23
    48	ADM --> UC24
    49	ADM --> UC25
    50	UC11 ..> UC12 : <<include>>
    51	@enduml

